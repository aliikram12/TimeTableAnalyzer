# Server Port (Render and Railway set this automatically)
PORT=3000

# Python binary to use ('python', 'python3', or specific path)
PYTHON_BIN=python

# CORS allowed origins (comma separated, or * for all)
# In production, set to your Vercel URL: https://your-frontend.vercel.app
CORS_ORIGIN=*

# Storage directories (optional, defaults to local folders)
UPLOADS_DIR=uploads
EXPORTS_DIR=exports
DATA_DIR=data
